# ── Database (PostgreSQL required for Vercel / production) ──────────────────
# Local: Docker, local Postgres, or a free Neon project
# Vercel: Settings → Environment Variables (Production + Builds)
#
# Neon example (pooled for runtime, direct for migrations):
# DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
#
# Use a *separate* database from misfinanzas-family (same table names).
# If you only have one URL (local Postgres), set both to the same value:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meat?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/meat?schema=public"

# ── Auth (required) ─────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-min-16-chars"
